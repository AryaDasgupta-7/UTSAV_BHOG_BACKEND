# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to a public repository.

PORT=3000

# This key protects your seller dashboard and admin API endpoints.
# Set it to a long, random string and keep it secret.
ADMIN_API_KEY=change-this-to-a-strong-secret

# Optional: get an email for every new order.
# These example values work with a Gmail account + an "app password"
# (Google Account > Security > 2-Step Verification > App passwords).
SELLER_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
FROM_EMAIL="Durga Pujo Bhog" <your-gmail-address@gmail.com>
